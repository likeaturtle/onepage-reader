/* 日程 · 一张纸：月份抬头、按天分节的细线表格 */

.agenda-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  padding-top: 8rpx;
}

.agenda-title-group {
  display: flex;
  flex-direction: column;
}

.agenda-year {
  font-size: 20rpx;
  letter-spacing: 0.24em;
  color: #8b8578;
}

.agenda-title {
  margin-top: 2rpx;
  font-size: 68rpx;
  font-weight: 300;
  line-height: 1.05;
  letter-spacing: 0.02em;
  color: #17181a;
}

.agenda-nav {
  display: flex;
  align-items: center;
  margin-bottom: 2rpx;
}

.agenda-nav-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  line-height: 1;
  color: #4e4b45;
}

.agenda-nav-hover {
  background: #f4f1e8;
}

.agenda-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 10rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #17181a;
  font-size: 20rpx;
  letter-spacing: 0.04em;
  color: #6f6b61;
}

.day {
  margin-top: 36rpx;
}

.day-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding-bottom: 6rpx;
}

.day-num {
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
  color: #17181a;
  font-feature-settings: "tnum";
}

.day-num.on {
  color: #1e3050;
  font-weight: 400;
}

.day-weekday {
  font-size: 22rpx;
  letter-spacing: 0.04em;
  color: #8b8578;
}

.day-count {
  margin-left: auto;
  font-size: 20rpx;
  color: #a39c8d;
}

.event {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f4f0e8;
}

.event-time {
  flex: none;
  width: 84rpx;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  font-size: 24rpx;
  color: #6f6b61;
  font-feature-settings: "tnum";
}

.event-end {
  font-size: 20rpx;
  color: #a39c8d;
}

.event-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.event-main-hover {
  opacity: 0.6;
}

.event-title {
  font-size: 28rpx;
  line-height: 1.45;
  color: #17181a;
  word-break: break-all;
}

.event-note {
  font-size: 22rpx;
  line-height: 1.5;
  color: #8b8578;
  word-break: break-all;
}

.event-local {
  margin-top: 2rpx;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: #8b7b4a;
}

.event-actions {
  flex: none;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 4rpx;
}

.event-actions .btn {
  width: auto !important;
  height: auto;
  min-width: 0;
  padding: 14rpx 6rpx;
  border: 0;
  background: transparent;
  font-size: 22rpx;
  letter-spacing: 0.04em;
  color: #8b8578;
}

.event-actions .btn.danger {
  color: #9c3427;
}

/* --- editor --------------------------------------------------------- */
.editor-section {
  margin-bottom: 48rpx;
  padding-top: 8rpx;
  border-top: 4rpx solid #1e3050;
}

.editor-section .section-head {
  border-bottom: 1rpx solid #ddd7c9;
}

.editor-section .line-row {
  border-bottom: 0;
}

.editor-error {
  margin-top: 20rpx;
}

.editor-actions {
  margin-top: 32rpx;
  gap: 20rpx;
}

.editor-actions .btn {
  flex: 1 1 0;
  width: auto !important;
  min-width: 0;
}
