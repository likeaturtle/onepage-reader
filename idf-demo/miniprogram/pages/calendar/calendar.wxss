/* Month list moved here from pages/index: the 日程 tab owns the list and
 * its delete action, so the 添加 tab stays a form. */

.month-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 100%;
  margin: 2rpx 0 20rpx;
  padding: 8rpx;
  background: #f7f2e7;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.month-btn {
  flex: 0 0 64rpx;
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #efe8d9;
  border-radius: 12rpx;
  color: #3f3b31;
  font-size: 38rpx;
  line-height: 1;
}

.month-btn-hover {
  background: #e4d9c3;
}

.month-label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #3f3b31;
  text-align: center;
  white-space: nowrap;
}

.day-group {
  margin-top: 26rpx;
}

.day-head {
  font-size: 23rpx;
  color: #8b8778;
  letter-spacing: 1rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #f0e9da;
}

.event {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f4eee1;
}

.event:last-child {
  border-bottom: none;
}

.event-time {
  flex: none;
  width: 108rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #22345a;
  font-variant-numeric: tabular-nums;
}

.event-end {
  margin-top: 2rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #a29b87;
}

.event-main {
  flex: 1;
  min-width: 0;
}

.event-title {
  font-size: 28rpx;
  line-height: 1.45;
  word-break: break-all;
}

.event-note {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #8b8778;
  word-break: break-all;
}

.event .btn {
  align-self: center;
  flex: 0 0 auto;
  width: auto !important;
}
