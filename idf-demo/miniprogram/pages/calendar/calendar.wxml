<view class="page">
  <view wx:if="{{error}}" class="banner error">{{error}}</view>

  <view wx:if="{{editorOpen}}" class="card editor">
    <view class="card-head">
      <view class="card-heading">
        <text class="card-title">编辑日程</text>
        <text class="hint">{{saving ? '保存中…' : '保存后同步到设备'}}</text>
      </view>
    </view>

    <view class="edit-row">
      <picker class="edit-item date" mode="date" value="{{editor.date}}" start="2020-01-01" end="2099-12-31" bindchange="onEditorDate">
        <view class="edit-field">{{editor.date}}</view>
      </picker>
      <picker class="edit-item" mode="time" value="{{editor.start}}" bindchange="onEditorStart">
        <view class="edit-field">{{editor.start}}</view>
      </picker>
      <text class="edit-dash">—</text>
      <picker class="edit-item" mode="time" value="{{editor.end}}" bindchange="onEditorEnd">
        <view class="edit-field">{{editor.end}}</view>
      </picker>
    </view>

    <input
      class="input"
      placeholder="日程标题"
      value="{{editor.title}}"
      maxlength="-1"
      bindinput="onEditorTitle"
      confirm-type="done"
    />
    <view class="counter">{{editorTitleBytes}} / {{titleLimit}} 字节</view>

    <textarea
      class="input area"
      placeholder="备注（可选）"
      value="{{editor.note}}"
      maxlength="-1"
      bindinput="onEditorNote"
    />
    <view class="counter">{{editorNoteBytes}} / {{noteLimit}} 字节</view>

    <view wx:if="{{editorError}}" class="banner error editor-error">{{editorError}}</view>

    <view class="row editor-actions">
      <button class="btn grow" bindtap="closeEditor" disabled="{{saving}}">取消</button>
      <button class="btn primary grow" bindtap="saveEditor" loading="{{saving}}" disabled="{{saving}}">保存</button>
    </view>
  </view>

  <view class="card">
    <view class="card-head">
      <view class="card-heading">
        <text class="card-title">本月日程</text>
        <text class="hint">{{eventCount}} 条</text>
      </view>
      <text class="hint status">{{loading ? '读取中…' : '云端'}}</text>
    </view>

    <view class="month-bar">
      <view class="month-btn" bindtap="prevMonth" hover-class="month-btn-hover" aria-role="button" aria-label="上个月">‹</view>
      <text class="month-label">{{monthLabel}}</text>
      <view class="month-btn" bindtap="nextMonth" hover-class="month-btn-hover" aria-role="button" aria-label="下个月">›</view>
    </view>

    <view wx:if="{{loading}}" class="empty">正在读取云端…</view>
    <view wx:elif="{{!groups.length && error}}" class="empty">云端日程加载失败，请检查网络后重试。</view>
    <view wx:elif="{{!groups.length}}" class="empty">本月还没有日程，到“添加”页新建一条。</view>

    <view wx:for="{{groups}}" wx:key="date" class="day-group">
      <view class="day-head">{{item.label}}</view>
      <view wx:for="{{item.items}}" wx:for-item="event" wx:key="id" class="event">
        <view class="event-time">
          <view>{{event.start}}</view>
          <view class="event-end">{{event.end}}</view>
        </view>
        <view
          class="event-main"
          bindtap="edit"
          data-id="{{event.id}}"
          hover-class="event-main-hover"
          aria-role="button"
          aria-label="编辑日程"
        >
          <view class="event-title">{{event.title}}</view>
          <view wx:if="{{event.note}}" class="event-note">{{event.note}}</view>
        </view>
        <view class="event-actions">
          <button class="btn tiny" catchtap="edit" data-id="{{event.id}}">编辑</button>
          <button class="btn tiny danger" catchtap="remove" data-id="{{event.id}}">删除</button>
        </view>
      </view>
    </view>
  </view>
</view>
