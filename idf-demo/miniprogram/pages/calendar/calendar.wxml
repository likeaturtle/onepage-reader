<view class="page">
  <view wx:if="{{error}}" class="banner error">{{error}}</view>
  <view wx:if="{{!loggedIn}}" class="banner local">未登录 · 日程只保存在本机，可编辑和删除，不会上传云端</view>

  <view wx:if="{{editorOpen}}" class="editor-section">
    <view class="section-head">
      <text class="section-title">编辑日程</text>
      <text class="hint">{{saving ? '保存中…' : (editor.local || !loggedIn ? '保存到本机' : '保存后同步到设备')}}</text>
    </view>

    <view class="line-row datetime-row">
      <text class="line-label">日期</text>
      <picker class="date-pick" mode="date" value="{{editor.date}}" start="2020-01-01" end="2099-12-31" bindchange="onEditorDate">
        <view class="line-value">{{editor.date}}</view>
      </picker>
      <view class="time-group">
        <picker class="time-pick" mode="time" value="{{editor.start}}" bindchange="onEditorStart">
          <view class="line-value">{{editor.start}}</view>
        </picker>
        <text class="dash">—</text>
        <picker class="time-pick" mode="time" value="{{editor.end}}" bindchange="onEditorEnd">
          <view class="line-value">{{editor.end}}</view>
        </picker>
      </view>
    </view>

    <view class="line-row title-row">
      <text class="line-label">标题</text>
      <input
        class="line-input"
        placeholder="日程标题"
        placeholder-class="line-placeholder"
        value="{{editor.title}}"
        maxlength="-1"
        bindinput="onEditorTitle"
        confirm-type="done"
      />
      <text class="line-counter">{{editorTitleBytes}}/{{titleLimit}}</text>
    </view>
    <view class="line-row note-row">
      <text class="line-label">备注</text>
      <textarea
        class="line-textarea"
        placeholder="备注（可选）"
        placeholder-class="line-placeholder"
        value="{{editor.note}}"
        maxlength="-1"
        bindinput="onEditorNote"
      />
    </view>
    <view class="line-counter note-counter">{{editorNoteBytes}}/{{noteLimit}}</view>

    <view wx:if="{{editorError}}" class="banner error editor-error">{{editorError}}</view>

    <view class="row editor-actions">
      <button class="btn grow" bindtap="closeEditor" disabled="{{saving}}">取消</button>
      <button class="btn primary grow" bindtap="saveEditor" loading="{{saving}}" disabled="{{saving}}">保存</button>
    </view>
  </view>

  <view class="agenda-head">
    <view class="agenda-title-group">
      <text class="agenda-year">{{monthYear}}</text>
      <text class="agenda-title">{{monthTitle}}</text>
    </view>
    <view class="agenda-nav">
      <text class="agenda-nav-btn" bindtap="prevMonth" hover-class="agenda-nav-hover" aria-role="button" aria-label="上个月">‹</text>
      <text class="agenda-nav-btn" bindtap="nextMonth" hover-class="agenda-nav-hover" aria-role="button" aria-label="下个月">›</text>
    </view>
  </view>
  <view class="agenda-meta">
    <text>{{eventCount}} 条日程</text>
    <text>{{!loggedIn ? '本机 · 未登录' : (loading ? '读取中…' : (localCount ? '云端 + 本机 ' + localCount + ' 条' : '云端 · 已同步'))}}</text>
  </view>

  <view wx:if="{{loading}}" class="empty">{{loggedIn ? '正在读取云端…' : '正在读取本机日程…'}}</view>
  <view wx:elif="{{!groups.length && error}}" class="empty">云端日程加载失败，请检查网络后重试。</view>
  <view wx:elif="{{!groups.length}}" class="empty">{{loggedIn ? '本月还没有日程，到「添加」页新建一条。' : '本月还没有日程，到「添加」页新建一条，暂时只保存在本机。'}}</view>

  <view wx:for="{{groups}}" wx:key="date" class="day">
    <view class="day-head">
      <text class="day-num {{item.today ? 'on' : ''}}">{{item.day}}</text>
      <text class="day-weekday">{{item.weekday}}{{item.today ? ' · 今天' : ''}}</text>
      <text class="day-count">{{item.items.length}} 条</text>
    </view>
    <view wx:for="{{item.items}}" wx:for-item="event" wx:key="id" class="event">
      <view class="event-time">
        <text>{{event.start}}</text>
        <text class="event-end">{{event.end}}</text>
      </view>
      <view
        class="event-main"
        bindtap="edit"
        data-id="{{event.id}}"
        hover-class="event-main-hover"
        aria-role="button"
        aria-label="编辑日程"
      >
        <text class="event-title">{{event.title}}</text>
        <text wx:if="{{event.note}}" class="event-note">{{event.note}}</text>
        <text wx:if="{{event.local}}" class="event-local">本机日程</text>
      </view>
      <view class="event-actions">
        <button class="btn tiny" catchtap="edit" data-id="{{event.id}}">编辑</button>
        <button class="btn tiny danger" catchtap="remove" data-id="{{event.id}}">删除</button>
      </view>
    </view>
  </view>
</view>
