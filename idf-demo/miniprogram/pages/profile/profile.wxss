.brand-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-logo {
  display: block;
  flex: none;
  width: 76rpx;
  height: 76rpx;
}

.brand-copy {
  min-width: 0;
}

.brand-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1b2a44;
  white-space: nowrap;
}

.brand-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8b8778;
  letter-spacing: 2rpx;
}

.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 32rpx;
}

.avatar-btn {
  width: 240rpx !important;
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn::after {
  border: none;
}

.avatar.big {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #e8dfcb;
  overflow: hidden;
}

.avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6d6551;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
}

.avatar-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9a9482;
}

.name-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 22rpx;
  box-sizing: border-box;
}

.name-row .input {
  width: auto;
  min-width: 0;
  margin-top: 0;
  flex: 1;
}

.name-row .btn {
  flex: 0 0 140rpx;
  width: 140rpx !important;
  min-width: 140rpx;
  height: 88rpx;
  padding: 0;
}

.user-id {
  width: 100%;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0e9da;
  word-break: break-all;
  text-align: center;
}

.explain-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.explain-text {
  font-size: 24rpx;
  line-height: 1.75;
  color: #7c7664;
  margin-top: 10rpx;
}

.devices-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.device-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #f0e9da;
}

.device-row:first-of-type {
  border-top: none;
}

.device-row-main {
  flex: 1;
  min-width: 0;
}

.device-row-name {
  font-size: 27rpx;
  color: #26251f;
  font-weight: 500;
}

.device-row-meta {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 4rpx 18rpx;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a9482;
  word-break: break-all;
}

/* Unbind is a text action, not a button: it sits after the bind time so the
 * row keeps a single line of information and the destructive action does not
 * compete with the device name. */
.unbind-link {
  color: #9c3427;
  text-decoration: underline;
  text-underline-offset: 3rpx;
  /* A 22rpx label is a small tap target; the negative margin keeps the text
   * where it was while the padding widens the hit area. */
  padding: 10rpx 6rpx;
  margin: -10rpx -6rpx;
}

.unbind-link.disabled {
  opacity: 0.4;
}
