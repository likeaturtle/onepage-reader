/* 我的 · 一张纸：账号抬头、设备与信息两段细线表、页尾退出 */

.profile-page {
  display: flex;
  flex-direction: column;
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #17181a;
}

.avatar-btn {
  width: 112rpx !important;
  height: 112rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.avatar-btn::after {
  border: none;
}

.avatar.big {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 1rpx solid #ddd7c9;
  background: transparent;
  overflow: hidden;
  flex: none;
}

.avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4e4b45;
  font-size: 40rpx;
  font-weight: 400;
  line-height: 1;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.name-input {
  flex: 1;
  width: auto;
  min-width: 0;
  height: 60rpx;
  padding: 0;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 60rpx;
  color: #17181a;
  background: transparent;
  border: 0;
  border-bottom: 1rpx solid #efeae0;
}

/* Guest has no editable nickname; the name carries the same weight as the
 * input so the masthead keeps its size. */
.guest-name {
  font-size: 40rpx;
  font-weight: 500;
  line-height: 60rpx;
  color: #17181a;
}

.name-placeholder {
  color: #a39c8d;
  font-weight: 400;
}

.avatar-meta {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #9a9487;
}

.save-link {
  flex: none;
  padding: 8rpx 0 8rpx 12rpx;
  font-size: 22rpx;
  color: #1e3050;
  white-space: nowrap;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.save-link-hover {
  opacity: 0.55;
}

.device-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f4f0e8;
}

.device-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.device-item-name {
  font-size: 26rpx;
  color: #17181a;
}

.device-item-meta {
  font-size: 20rpx;
  line-height: 1.5;
  color: #9a9487;
  word-break: break-all;
}

/* Unbind is a text action, not a button; the padding widens the hit area
 * without moving the word. */
.unbind-link {
  flex: none;
  padding: 16rpx 0 16rpx 24rpx;
  font-size: 22rpx;
  color: #9c3427;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.unbind-link.disabled {
  opacity: 0.4;
}

.note-text {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.95;
  color: #8b8578;
}

.logout-row {
  margin-top: 48rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #ddd7c9;
  text-align: center;
}

.logout-link {
  display: inline-block;
  padding: 12rpx 24rpx;
  font-size: 22rpx;
  letter-spacing: 0.1em;
  color: #9c3427;
}
