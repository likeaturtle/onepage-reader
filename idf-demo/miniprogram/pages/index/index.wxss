.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-logo {
  display: block;
  flex: none;
  width: 68rpx;
  height: 68rpx;
}

.brand-copy {
  min-width: 0;
}

.brand-name {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0;
  color: #1b2a44;
  white-space: nowrap;
}

.brand-sub {
  font-size: 21rpx;
  color: #8b8778;
  letter-spacing: 2rpx;
}

.user {
  display: flex;
  align-items: center;
  gap: 12rpx;
  max-width: 300rpx;
}

.avatar {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #e8dfcb;
  flex: none;
}

.avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6d6551;
  font-size: 26rpx;
  font-weight: 600;
}

.user-name {
  font-size: 25rpx;
  color: #5f5a4b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.actions {
  margin-top: 24rpx;
}

.actions .btn {
  flex: 1 1 0;
  width: auto !important;
  min-width: 0;
  padding: 0 12rpx;
  font-size: 27rpx;
}

.scan-tip {
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9a9482;
}

/* The device header doubles as the collapse control once the board is
 * connected: the body folds away and the header stays tappable. */
.card-head.collapsed {
  margin-bottom: 0;
}

/* The lamp sits left of the "已连接" label, so the title row centres its items
 * instead of aligning them on the text baseline. */
.card-head.device-head {
  align-items: center;
}

.device-head .card-heading {
  align-items: center;
}

.device-head .dot {
  flex: none;
}

/* The lamp used to close out the row; that slot now holds the expand/collapse
 * control. It stays plain text + caret (no chip, border or fill) so it reads as
 * part of the header; tapping anywhere on the row still folds the card. */
.head-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: none;
  color: #8b8778;
  font-size: 22rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.head-caret {
  width: 0;
  height: 0;
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
  border-top: 8rpx solid #8b8778;
  transition: transform 0.15s ease;
}

/* "展开" points down (the panel opens below), "收起" flips it up. */
.head-caret.up {
  transform: rotate(180deg);
}

.card-head-hover {
  background: #f7f2e7;
}

/* Scan status sits between the switch row and the card edge; the generic
 * 56 rpx empty-state padding reads as a hole there, so keep it one tight line.
 * The month card keeps the roomier .empty. */
.empty.compact {
  padding: 20rpx 0 6rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 20rpx 22rpx;
  background: #f7f2e7;
  border-radius: 18rpx;
}

.switch-title {
  font-size: 26rpx;
}

.switch-row > view:first-child {
  flex: 1;
  min-width: 0;
}

.switch-desc {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #98917d;
}

.device-list {
  margin-top: 22rpx;
  border-top: 1rpx solid #efe8d8;
}

.device .btn {
  flex: 0 0 auto;
  width: auto !important;
}

.device {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #efe8d8;
}

.device-main {
  flex: 1;
  min-width: 0;
}

.device-name {
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9a9482;
}

.device-info {
  background: #f7f2e7;
  border-radius: 18rpx;
  padding: 12rpx 22rpx;
}

.pick-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.pick-item {
  flex: 1;
  min-width: 0;
}

.pick-item.date {
  flex: 1.35;
}

.pick {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 8rpx;
  font-size: 27rpx;
  text-align: center;
  white-space: nowrap;
}

.pick-hover {
  background: #efe8d9;
}

.pick.open {
  border-color: #22345a;
  background: #eef1f7;
}

/* Inline month grid for the date field. Six fixed weeks keep the panel the
 * same height across months; the palette is the same paper tone as the form. */
.cal {
  margin: 14rpx 0 4rpx;
  padding: 14rpx 14rpx 12rpx;
  background: #f7f2e7;
  border: 1rpx solid #e4dccb;
  border-radius: 18rpx;
}

.cal-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.cal-nav {
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #efe8d9;
  border-radius: 12rpx;
  color: #3f3b31;
  font-size: 32rpx;
  line-height: 1;
}

.cal-nav-hover {
  background: #e4d9c3;
}

.cal-label {
  flex: 1;
  min-width: 0;
  text-align: center;
  font-size: 27rpx;
  color: #3f3b31;
  white-space: nowrap;
}

.cal-today {
  flex: none;
  height: 56rpx;
  padding: 0 16rpx;
  line-height: 56rpx;
  border-radius: 12rpx;
  background: #eae3d3;
  color: #4f5d46;
  font-size: 24rpx;
}

.cal-today-hover {
  background: #ded4bf;
}

.cal-week,
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-weekday {
  width: 14.2857%;
  line-height: 40rpx;
  text-align: center;
  font-size: 21rpx;
  color: #9a9482;
}

.cal-cell {
  width: 14.2857%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.cal-day {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  box-sizing: border-box;
  font-size: 27rpx;
  line-height: 1;
  color: #3f3b31;
  font-variant-numeric: tabular-nums;
}

.cal-cell.out .cal-day {
  color: #c3bca8;
}

.cal-cell.today .cal-day {
  border: 1rpx solid #b9c3d6;
  color: #22345a;
  font-weight: 700;
}

.cal-cell.sel .cal-day {
  background: #22345a;
  border-color: #22345a;
  color: #ffffff;
  font-weight: 600;
}

.cal-cell-hover .cal-day {
  background: #eae3d3;
}

.dash {
  color: #a49d89;
  flex: none;
  font-size: 26rpx;
}

.inline-tip {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-left: 5rpx solid #cfd8c2;
  background: #f4f6ef;
  border-radius: 8rpx;
  color: #737c63;
  font-size: 23rpx;
  line-height: 1.6;
}

.log-wrap {
  margin-top: 10rpx;
}

.log-toggle {
  text-align: center;
  font-size: 23rpx;
  color: #9a9482;
  padding: 18rpx 0;
}

.log {
  height: 320rpx;
  background: #26251f;
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
}

.log-line {
  font-family: Menlo, Consolas, monospace;
  font-size: 20rpx;
  line-height: 1.6;
  color: #d8d2c2;
  word-break: break-all;
}
