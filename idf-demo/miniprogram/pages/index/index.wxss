/* 添加 · 一张纸：日期抬头、设备一行、语音一句、四行表单 */

.masthead {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding-bottom: 8rpx;
}

.kicker {
  font-size: 22rpx;
  letter-spacing: 0.16em;
  color: #8b8578;
}

.masthead-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin-top: 6rpx;
}

.masthead-day {
  font-size: 112rpx;
  font-weight: 200;
  line-height: 0.9;
  letter-spacing: -0.02em;
  color: #17181a;
  font-feature-settings: "tnum";
}

.masthead-side {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  padding-bottom: 10rpx;
  font-size: 20rpx;
  line-height: 1.5;
  letter-spacing: 0.06em;
  color: #8b8578;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid #ddd7c9;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4e4b45;
  font-size: 24rpx;
  flex: none;
  margin-top: 8rpx;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-hover {
  background: #f4f1e8;
}

/* --- device --------------------------------------------------------- */
.device-section {
  margin-top: 8rpx;
  border-top: 0;
}

.device-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  border-bottom: 0;
}

.device-line-hover {
  background: #f7f4ec;
}

.device-name {
  font-size: 26rpx;
  color: #17181a;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-state {
  font-size: 22rpx;
  letter-spacing: 0.04em;
  color: #1e3050;
  flex: none;
}

.device-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: none;
}

.device-action {
  font-size: 22rpx;
  color: #6f6b61;
  padding: 12rpx 0;
}

.device-action.danger {
  color: #9c3427;
}

.device-caret {
  width: 0;
  height: 0;
  border-left: 9rpx solid transparent;
  border-right: 9rpx solid transparent;
  border-top: 10rpx solid #9a9487;
  flex: none;
  transition: transform 0.15s ease;
}

.device-caret.up {
  transform: rotate(180deg);
}

.device-info {
  padding: 4rpx 0 0;
}

.device-info .kv {
  border-bottom: 0;
}

.device-copy {
  margin-top: 20rpx;
}

.actions {
  margin-top: 28rpx;
}

.actions .btn {
  flex: 1 1 0;
  width: auto !important;
  min-width: 0;
  padding: 0 16rpx;
  font-size: 26rpx;
}

.actions .btn + .btn {
  flex: 0 0 auto;
  padding: 0 28rpx;
}

.scan-tip {
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9a9487;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 32rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #efeae0;
}

.switch-copy {
  flex: 1;
  min-width: 0;
}

.switch-title {
  font-size: 24rpx;
  color: #17181a;
}

.switch-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #98917d;
}

.scan-list {
  border-top: 1rpx solid #efeae0;
}

.scan-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #efeae0;
}

.scan-main {
  flex: 1;
  min-width: 0;
}

.scan-name {
  font-size: 26rpx;
  color: #17181a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scan-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9a9487;
}

.scan-item .btn {
  flex: 0 0 auto;
  width: auto !important;
}

/* --- section -------------------------------------------------------- */
.section {
  margin-top: 28rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #efeae0;
}

.section-title {
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0.14em;
  color: #6f6b61;
}

/* --- voice ---------------------------------------------------------- */
.voice-text {
  width: 100%;
  height: 88rpx;
  margin-top: 16rpx;
  padding: 0;
  font-size: 28rpx;
  line-height: 1.6;
  color: #17181a;
  background: transparent;
  border: 0;
  box-sizing: border-box;
}

.voice-placeholder {
  font-size: 28rpx;
  color: #a39c8d;
}

.voice-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.voice-hold {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 96rpx;
  overflow: hidden;
  border: 1rpx solid #17181a;
  border-radius: 4rpx;
  background: transparent;
  color: #17181a;
  font-size: 28rpx;
  letter-spacing: 0.1em;
  line-height: 1;
  box-sizing: border-box;
  -webkit-user-select: none;
  user-select: none;
}

.voice-hold-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 100%;
  min-width: 0;
}

.voice-fill {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  background: #1e3050;
  color: #fbfaf6;
  transition: clip-path 0.15s linear;
  -webkit-transition: clip-path 0.15s linear;
  pointer-events: none;
}

.voice-elapsed {
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
  opacity: 0.85;
}

.voice-hold-hover {
  background: #f4f1e8;
}

.voice-hold.off {
  opacity: 0.4;
}

.voice-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #9c3427;
}

.voice-fill .voice-dot {
  background: #fbfaf6;
  animation: voice-pulse 1s infinite;
}

@keyframes voice-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.45; transform: scale(0.8); }
}

.voice-parse-slot {
  flex: none;
  display: flex;
  align-items: center;
}

.btn.voice-confirm {
  width: auto;
  height: 96rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: #1e3050;
  font-size: 24rpx;
  letter-spacing: 0.04em;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.voice-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #a39c8d;
}

.voice-error {
  margin-top: 16rpx;
}

.voice-filled {
  margin: 20rpx 0 0;
  border-left-color: #b9c3d6;
  color: #4a5a78;
}

/* --- form ----------------------------------------------------------- */
.line-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  border-bottom: 0;
}

.line-label {
  width: 72rpx;
  flex: none;
  font-size: 22rpx;
  letter-spacing: 0.04em;
  color: #9a9487;
}

.line-value {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #17181a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-feature-settings: "tnum";
}

.line-value.open {
  color: #1e3050;
}

.pick-hover {
  background: #f4f1e8;
}

.time-pick {
  flex: 1;
  min-width: 0;
}

.dash {
  flex: none;
  font-size: 22rpx;
  color: #a39c8d;
}

.line-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0;
  font-size: 28rpx;
  color: #17181a;
  background: transparent;
  border: 0;
}

.line-placeholder {
  color: #a39c8d;
}

.line-counter {
  flex: none;
  font-size: 20rpx;
  color: #a39c8d;
  font-feature-settings: "tnum";
}

.note-row {
  align-items: flex-start;
  padding-top: 16rpx;
}

.line-textarea {
  flex: 1;
  width: 100%;
  height: 96rpx;
  margin-top: 2rpx;
  padding: 0;
  font-size: 26rpx;
  line-height: 48rpx;
  color: #17181a;
  background-color: transparent;
  border: 0;
}

.note-counter {
  margin-top: 4rpx;
}

.save-btn {
  margin-top: 12rpx;
}

/* --- month grid ----------------------------------------------------- */
.cal {
  padding: 12rpx 0 8rpx;
  border-bottom: 1rpx solid #efeae0;
}

.cal-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cal-nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #4e4b45;
}

.cal-nav-hover {
  background: #f4f1e8;
}

.cal-label {
  flex: 1;
  min-width: 0;
  text-align: center;
  font-size: 24rpx;
  color: #17181a;
  white-space: nowrap;
}

.cal-today {
  flex: none;
  padding: 8rpx 0 8rpx 16rpx;
  font-size: 22rpx;
  color: #1e3050;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.cal-today-hover {
  opacity: 0.55;
}

.cal-week,
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-weekday {
  width: 14.2857%;
  line-height: 48rpx;
  text-align: center;
  font-size: 20rpx;
  color: #9a9487;
}

.cal-cell {
  width: 14.2857%;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.cal-day {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1;
  color: #3f3b31;
  font-variant-numeric: tabular-nums;
}

.cal-cell.out .cal-day {
  color: #cfc9bb;
}

.cal-cell.today .cal-day {
  border: 1rpx solid #1e3050;
  color: #1e3050;
  font-weight: 500;
}

.cal-cell.sel .cal-day {
  background: #1e3050;
  border-color: #1e3050;
  color: #ffffff;
}

.cal-cell-hover .cal-day {
  background: #f0ece2;
}

/* --- pairing -------------------------------------------------------- */
.pairing-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 48rpx 360rpx;
  background: rgba(20, 19, 15, 0.42);
}

.pairing-card {
  width: 100%;
  max-width: 640rpx;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
  background: #fbfaf6;
  border: 1rpx solid #17181a;
  border-radius: 4rpx;
  box-shadow: 12rpx 14rpx 0 rgba(23, 24, 26, 0.08);
}

.pairing-title {
  color: #17181a;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 0.06em;
}

.pairing-input {
  margin-top: 24rpx;
  font-family: Menlo, Consolas, monospace;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.pairing-placeholder {
  color: #a9a293;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  letter-spacing: 0;
  font-size: 24rpx;
}

.pairing-error {
  margin-top: 16rpx;
  color: #9c3427;
  font-size: 24rpx;
}

.pairing-hint {
  margin-top: 16rpx;
  color: #8d876f;
  font-size: 24rpx;
}

.pairing-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.pairing-actions .pairing-btn {
  flex: 1 1 0;
  width: auto;
  min-width: 0;
  padding: 0 12rpx;
}
