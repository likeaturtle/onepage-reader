<view class="page">
  <view class="topbar">
    <view class="brand">
      <image class="brand-logo" src="/CalCal_logo.png" mode="aspectFit" />
      <view class="brand-copy">
        <view class="brand-name">{{appName}}</view>
        <view class="brand-sub">{{tagline}}</view>
      </view>
    </view>
    <view class="user" bindtap="goProfile">
      <image wx:if="{{userAvatar}}" class="avatar" src="{{userAvatar}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-text">{{userInitial}}</view>
      <text class="user-name">{{user.nickname || '微信用户'}}</text>
    </view>
  </view>

  <view wx:if="{{!adapterAvailable}}" class="banner error">
    系统蓝牙不可用，请打开并允许微信使用蓝牙后重试
  </view>
  <view wx:if="{{error}}" class="banner error">{{error}}</view>
  <view wx:if="{{syncError}}" class="banner warn">{{syncError}}</view>
  <view wx:if="{{!connected}}" class="banner cloud">
    未连接设备，日程保存在云端，连接设备后自动同步
  </view>

  <view class="card">
    <view
      class="card-head device-head {{connected && !deviceOpen ? 'collapsed' : ''}}"
      bindtap="toggleDeviceCard"
      hover-class="{{connected ? 'card-head-hover' : 'none'}}"
      aria-role="{{connected ? 'button' : ''}}"
      aria-label="{{connected ? (deviceOpen ? '收起设备信息' : '展开设备信息') : ''}}"
    >
      <view class="card-heading">
        <text class="card-title">设备</text>
        <view class="dot {{connected ? 'on' : ''}}"></view>
        <text class="hint">{{connected ? '已连接' : (connecting ? '连接中…' : '未连接')}}</text>
      </view>
      <view wx:if="{{connected}}" class="head-toggle">
        <text>{{deviceOpen ? '收起' : '展开'}}</text>
        <view class="head-caret {{deviceOpen ? 'up' : ''}}"></view>
      </view>
    </view>

    <block wx:if="{{!connected}}">
      <view class="muted">先按设备 POWER 键唤醒再扫描并连接</view>
      <view class="row actions">
        <button class="btn primary grow" bindtap="startScan" loading="{{scanning}}" disabled="{{connecting || scanning}}">
          {{scanning ? '正在扫描…' : (hasScanned ? '重新扫描' : '扫描设备')}}
        </button>
        <button wx:if="{{scanning}}" class="btn" bindtap="stopScan">停止</button>
      </view>
      <view wx:if="{{scanning}}" class="scan-tip">扫描约 5 秒后自动停止</view>
      <view wx:elif="{{hasScanned}}" class="scan-tip">扫描完成 · {{devices.length}} 个设备</view>

      <view class="switch-row">
        <view>
          <view class="switch-title">显示全部蓝牙设备</view>
          <view class="switch-desc">找不到设备时打开右侧开关，手动选择名为 Mochen CalCal 的设备</view>
        </view>
        <switch checked="{{showAllDevices}}" color="#22345a" bindchange="toggleAllDevices" />
      </view>

      <view wx:if="{{devices.length}}" class="device-list">
        <view
          wx:for="{{devices}}"
          wx:key="deviceId"
          class="device"
          bindtap="connect"
          data-id="{{item.deviceId}}"
        >
          <view class="device-main">
            <view class="device-name">{{item.name}}</view>
            <view class="device-meta">信号 {{item.RSSI}} dBm</view>
          </view>
          <button class="btn small" catchtap="connect" data-id="{{item.deviceId}}">连接</button>
        </view>
      </view>
      <view wx:elif="{{scanning}}" class="empty compact">正在搜索附近的蓝牙设备</view>
      <view wx:elif="{{hasScanned}}" class="empty compact">未发现设备，请确认设备已唤醒并重新扫描</view>
    </block>

    <block wx:else>
      <view wx:if="{{deviceOpen}}" class="device-info">
        <view class="kv"><text>名称</text><text>{{hello.name || appName}}</text></view>
        <view class="kv"><text>固件</text><text>{{hello.fw || '—'}}</text></view>
        <view class="kv"><text>设备日程</text><text>{{hello.events || 0}} 条</text></view>
        <view class="kv"><text>设备时间</text><text>{{deviceTime || '未同步'}}</text></view>
      </view>
      <view class="row actions">
        <button class="btn grow" bindtap="refresh" loading="{{syncing}}">同步</button>
        <button class="btn grow" bindtap="sleepDevice">锁屏休眠</button>
        <button class="btn danger grow" bindtap="disconnect">断开</button>
      </view>
    </block>
  </view>

  <view class="card">
    <view class="card-head">
      <view class="card-heading">
        <text class="card-title">语音日程</text>
        <text class="hint">{{voiceStatus}}</text>
      </view>
    </view>

    <textarea
      class="input area voice-text"
      placeholder="按住下方按钮说一句，例如：明天下午三点项目评审，会议室 A"
      value="{{voiceText}}"
      maxlength="500"
      bindinput="onVoiceText"
      disabled="{{voicePhase !== ''}}"
    />

    <view class="voice-actions">
      <view
        class="voice-hold {{voiceRecording ? 'recording' : ''}} {{voicePhase ? 'off' : ''}}"
        bindtouchstart="startVoice"
        bindtouchend="stopVoice"
        bindtouchcancel="onVoiceTouchCancel"
        catchtouchmove="noop"
        hover-class="voice-hold-hover"
        aria-role="button"
        aria-label="{{voiceRecording ? '松开结束录音' : '按住说话'}}"
      >
        <view class="voice-hold-content">
          <view class="voice-dot"></view>
          <text>{{voiceButtonLabel}}</text>
          <text wx:if="{{voiceRecording}}" class="voice-elapsed">{{voiceElapsed}}</text>
        </view>
        <!-- Red progress layer clipped to the elapsed share of the 60 s
         * limit. It repeats the button content in white so the label stays
         * readable over both the beige rest and the red fill. -->
        <view
          wx:if="{{voiceRecording}}"
          class="voice-fill"
          style="clip-path: inset(0 {{100 - voiceProgress}}% 0 0); -webkit-clip-path: inset(0 {{100 - voiceProgress}}% 0 0)"
          aria-hidden="true"
        >
          <view class="voice-hold-content">
            <view class="voice-dot"></view>
            <text>{{voiceButtonLabel}}</text>
            <text class="voice-elapsed">{{voiceElapsed}}</text>
          </view>
        </view>
      </view>
      <view class="voice-parse-slot">
        <button
          class="btn primary voice-confirm"
          bindtap="confirmVoice"
          loading="{{voicePhase === 'parsing'}}"
          disabled="{{voicePhase !== '' || voiceRecording || busy}}"
        >解析日程</button>
      </view>
    </view>

    <view wx:if="{{voiceError}}" class="banner error voice-error">{{voiceError}}</view>
    <view wx:else class="voice-note">录音会发送到 DeepSeek 识别，单次最长 60 秒，确认文字后填入下方表单</view>
  </view>

  <view id="add-card" class="card">
    <view class="card-head">
      <view class="card-heading">
        <text class="card-title">添加日程</text>
        <text class="hint">{{voiceFilled ? '请确认后保存' : (connected ? '同时写入设备' : '先保存到云端')}}</text>
      </view>
    </view>

    <view wx:if="{{voiceFilled}}" class="inline-tip voice-filled">
      已按语音填入，请核对日期、时间和标题后点「保存日程」
    </view>

    <view class="pick-row">
      <view class="pick-item date">
        <view
          class="field pick {{calendarOpen ? 'open' : ''}}"
          bindtap="toggleCalendar"
          hover-class="pick-hover"
          aria-role="button"
          aria-label="选择日期"
        >{{form.date}}</view>
      </view>
      <picker class="pick-item time" mode="time" value="{{form.start}}" bindchange="onStart">
        <view class="field pick">{{form.start}}</view>
      </picker>
      <text class="dash">—</text>
      <picker class="pick-item time" mode="time" value="{{form.end}}" bindchange="onEnd">
        <view class="field pick">{{form.end}}</view>
      </picker>
    </view>

    <view wx:if="{{calendarOpen}}" class="cal">
      <view class="cal-head">
        <view class="cal-nav" data-delta="-1" bindtap="shiftCalendarMonth" hover-class="cal-nav-hover" aria-role="button" aria-label="上个月">‹</view>
        <text class="cal-label">{{calendarLabel}}</text>
        <view class="cal-nav" data-delta="1" bindtap="shiftCalendarMonth" hover-class="cal-nav-hover" aria-role="button" aria-label="下个月">›</view>
        <view class="cal-today" bindtap="pickToday" hover-class="cal-today-hover" aria-role="button" aria-label="选择今天">今天</view>
      </view>
      <view class="cal-week">
        <text wx:for="{{weekdays}}" wx:key="*this" class="cal-weekday">{{item}}</text>
      </view>
      <view class="cal-grid">
        <view
          wx:for="{{calendarCells}}"
          wx:key="key"
          class="cal-cell {{item.inMonth ? 'in' : 'out'}} {{item.selected ? 'sel' : ''}} {{item.today ? 'today' : ''}}"
          data-date="{{item.date}}"
          bindtap="pickDay"
          hover-class="cal-cell-hover"
          aria-role="button"
          aria-label="{{item.date}}"
        >
          <view class="cal-day">{{item.day}}</view>
        </view>
      </view>
    </view>

    <input
      class="input"
      placeholder="日程标题，例如 项目评审"
      value="{{form.title}}"
      maxlength="-1"
      bindinput="onTitle"
      confirm-type="done"
    />
    <view class="counter">{{titleBytes}} / {{titleLimit}} 字节</view>

    <textarea
      class="input area"
      placeholder="备注（可选）"
      value="{{form.note}}"
      maxlength="-1"
      bindinput="onNote"
    />
    <view class="counter">{{noteBytes}} / {{noteLimit}} 字节</view>

    <view wx:if="{{!connected}}" class="inline-tip">
      未连接设备蓝牙，保存后云端储存，连接设备时自动同步
    </view>

    <button class="btn primary block" bindtap="submit" loading="{{busy}}" disabled="{{busy || voicePhase !== ''}}">
      保存日程
    </button>
  </view>

  <view class="log-wrap">
    <view class="log-toggle" bindtap="toggleLog">
      {{logOpen ? '收起协议日志' : '查看蓝牙协议日志'}}
    </view>
    <scroll-view wx:if="{{logOpen}}" class="log" scroll-y>
      <view wx:for="{{logs}}" wx:key="id" class="log-line">{{item.line}}</view>
      <view wx:if="{{!logs.length}}" class="log-line">（连接设备后显示）</view>
    </scroll-view>
  </view>
</view>
