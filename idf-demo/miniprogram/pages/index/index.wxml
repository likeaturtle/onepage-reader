<view class="page">
  <view class="masthead">
    <view class="masthead-main">
      <text class="kicker">今天 · {{today.weekday}}</text>
      <view class="masthead-row">
        <text class="masthead-day">{{today.day}}</text>
        <view class="masthead-side">
          <text>{{today.title}}</text>
          <text>{{today.year}}</text>
        </view>
      </view>
    </view>
    <view class="avatar" bindtap="goProfile" hover-class="avatar-hover" aria-role="button" aria-label="我的">
      <image wx:if="{{userAvatar}}" class="avatar-img" src="{{userAvatar}}" mode="aspectFill" />
      <image wx:elif="{{!loggedIn}}" class="avatar-logo" src="/CalCal_logo.png" mode="aspectFit" />
      <text wx:else>{{userInitial}}</text>
    </view>
  </view>

  <view wx:if="{{!loggedIn}}" class="banner local">
    未登录 · 日程只保存在本机，不会上传云端或同步设备
  </view>

  <view wx:if="{{!adapterAvailable}}" class="banner error banner-switch">
    <text class="banner-copy">{{adapterHint}}</text>
    <view
      wx:if="{{adapterActionLabel}}"
      class="banner-link"
      hover-class="banner-link-hover"
      bindtap="enableBluetooth"
    >
      <text class="banner-link-text">{{adapterActionLabel}}</text>
    </view>
  </view>
  <view wx:if="{{error}}" class="banner error">{{error}}</view>
  <view wx:if="{{syncError}}" class="banner warn">{{syncError}}</view>
  <view wx:if="{{!connected && loggedIn}}" class="banner cloud">
    未连接设备，日程保存在云端，连接设备后自动同步
  </view>

  <!-- Device: one status line; the scan panel expands when disconnected. -->
  <view class="device-section">
    <view
      class="device-line"
      bindtap="toggleDeviceCard"
      hover-class="{{connected ? 'device-line-hover' : 'none'}}"
      aria-role="{{connected ? 'button' : ''}}"
      aria-label="{{connected ? (deviceOpen ? '收起设备信息' : '展开设备信息') : ''}}"
    >
      <view class="dot {{connected ? 'on' : ''}}"></view>
      <text class="device-name">{{connected ? (hello.name || appName) : '墨程CalCal'}}</text>
      <text class="device-state">{{connected ? '已连接' : (connecting ? '连接中…' : '未连接')}}</text>
      <view wx:if="{{connected}}" class="device-actions">
        <text class="device-action" catchtap="refresh">{{syncing ? '同步中' : '同步'}}</text>
        <text class="device-action" catchtap="sleepDevice">休眠</text>
        <text class="device-action danger" catchtap="disconnect">断开</text>
      </view>
      <view wx:if="{{connected}}" class="device-caret {{deviceOpen ? 'up' : ''}}"></view>
    </view>

    <view wx:if="{{connected && deviceOpen}}" class="device-info">
      <view class="kv"><text>名称</text><text>{{hello.name || appName}}</text></view>
      <view class="kv"><text>固件</text><text>{{hello.fw || '—'}}</text></view>
      <view class="kv"><text>设备日程</text><text>{{hello.events || 0}} 条</text></view>
      <view class="kv"><text>设备时间</text><text>{{deviceTime || '未同步'}}</text></view>
    </view>

    <block wx:if="{{!connected}}">
      <view class="muted device-copy">扫描前请先唤醒设备</view>
      <view class="row actions">
        <button class="btn primary grow" bindtap="startScan" loading="{{scanning}}" disabled="{{connecting || scanning}}">
          {{scanning ? '正在扫描…' : (hasScanned ? '重新扫描' : '扫描设备')}}
        </button>
        <button wx:if="{{scanning}}" class="btn" bindtap="stopScan">停止</button>
      </view>
      <view wx:if="{{scanning}}" class="scan-tip">扫描约 5 秒后自动停止</view>
      <view wx:elif="{{hasScanned}}" class="scan-tip">扫描完成 · {{devices.length}} 个设备</view>

      <view class="switch-row">
        <view class="switch-copy">
          <view class="switch-title">显示全部蓝牙设备</view>
          <view class="switch-desc">无法找到设备时，可开启右侧开关手动选择</view>
        </view>
        <switch checked="{{showAllDevices}}" color="#1e3050" bindchange="toggleAllDevices" />
      </view>

      <view wx:if="{{devices.length}}" class="scan-list">
        <view
          wx:for="{{devices}}"
          wx:key="deviceId"
          class="scan-item"
          bindtap="connect"
          data-id="{{item.deviceId}}"
        >
          <view class="scan-main">
            <view class="scan-name">{{item.name}}</view>
            <view class="scan-meta">信号 {{item.RSSI}} dBm</view>
          </view>
          <button class="btn small" catchtap="connect" data-id="{{item.deviceId}}">连接</button>
        </view>
      </view>
      <view wx:elif="{{scanning}}" class="empty compact">正在搜索附近的蓝牙设备</view>
      <view wx:elif="{{hasScanned}}" class="empty compact">未发现设备，请确认设备已唤醒并重新扫描</view>
    </block>
  </view>

  <!-- Voice: one-sentence capture. -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">说一句</text>
      <text class="hint">{{voiceStatus}}</text>
    </view>

    <textarea
      class="voice-text"
      placeholder="{{loggedIn ? '按住下方按钮说出日程' : '登录后可用语音输入'}}"
      placeholder-class="voice-placeholder"
      value="{{voiceText}}"
      maxlength="500"
      bindinput="onVoiceText"
      disabled="{{voicePhase !== '' || !loggedIn}}"
    />

    <view class="voice-actions">
      <view
        class="voice-hold {{voiceRecording ? 'recording' : ''}} {{voicePhase || !loggedIn ? 'off' : ''}}"
        bindtouchstart="startVoice"
        bindtouchend="stopVoice"
        bindtouchcancel="onVoiceTouchCancel"
        catchtouchmove="noop"
        hover-class="voice-hold-hover"
        aria-role="button"
        aria-disabled="{{!loggedIn}}"
        aria-label="{{!loggedIn ? '登录后可使用语音日程' : (voiceRecording ? '松开结束录音' : '按住说话')}}"
      >
        <view class="voice-hold-content">
          <view class="voice-dot"></view>
          <text>{{voiceButtonLabel}}</text>
          <text wx:if="{{voiceRecording}}" class="voice-elapsed">{{voiceElapsed}}</text>
        </view>
        <!-- Red progress layer clipped to the elapsed share of the 60 s
         * limit. It repeats the button content in white so the label stays
         * readable over both the paper rest and the ink fill. -->
        <view
          wx:if="{{voiceRecording}}"
          class="voice-fill"
          style="{{voiceClipStyle}}"
          aria-hidden="true"
        >
          <view class="voice-hold-content">
            <view class="voice-dot"></view>
            <text>{{voiceButtonLabel}}</text>
            <text class="voice-elapsed">{{voiceElapsed}}</text>
          </view>
        </view>
      </view>
      <view class="voice-parse-slot">
        <button
          class="btn voice-confirm"
          bindtap="confirmVoice"
          loading="{{voicePhase === 'parsing'}}"
          disabled="{{voicePhase !== '' || voiceRecording || busy || !loggedIn}}"
        >解析日程</button>
      </view>
    </view>

    <view wx:if="{{voiceError}}" class="banner error voice-error">{{voiceError}}</view>
    <view wx:elif="{{!loggedIn}}" class="voice-note">未登录不可使用语音识别与日程解析；登录后可按住说话并让 AI 填写表单</view>
    <view wx:else class="voice-note">录音单次最长 60 秒，语音输入和日程解析使用云端服务</view>
  </view>

  <!-- Event: a four-line paper form. -->
  <view id="add-card" class="section form-section">
    <view class="section-head">
      <text class="section-title">日程</text>
      <text class="hint">{{voiceFilled ? '已按语音填好' : (!loggedIn ? '只保存到本机' : (connected ? '同时写入设备' : '先保存到云端'))}}</text>
    </view>

    <view wx:if="{{voiceFilled}}" class="inline-tip voice-filled">
      已按语音内容解析日程，请核对后点「保存日程」
    </view>

    <view class="line-row datetime-row">
      <text class="line-label">日期</text>
      <view
        class="line-value pick datetime-date {{calendarOpen ? 'open' : ''}}"
        bindtap="toggleCalendar"
        hover-class="pick-hover"
        aria-role="button"
        aria-label="选择日期"
      >{{form.date}}</view>
      <view class="time-group">
        <picker class="time-pick" mode="time" value="{{form.start}}" bindchange="onStart">
          <view class="line-value">{{form.start}}</view>
        </picker>
        <text class="dash">—</text>
        <picker class="time-pick" mode="time" value="{{form.end}}" bindchange="onEnd">
          <view class="line-value">{{form.end}}</view>
        </picker>
      </view>
    </view>

    <view wx:if="{{calendarOpen}}" class="cal">
      <view class="cal-head">
        <view class="cal-nav" data-delta="-1" bindtap="shiftCalendarMonth" hover-class="cal-nav-hover" aria-role="button" aria-label="上个月">‹</view>
        <text class="cal-label">{{calendarLabel}}</text>
        <view class="cal-nav" data-delta="1" bindtap="shiftCalendarMonth" hover-class="cal-nav-hover" aria-role="button" aria-label="下个月">›</view>
        <view class="cal-today" bindtap="pickToday" hover-class="cal-today-hover" aria-role="button" aria-label="选择今天">今天</view>
      </view>
      <view class="cal-week">
        <text wx:for="{{weekdays}}" wx:key="*this" class="cal-weekday">{{item}}</text>
      </view>
      <view class="cal-grid">
        <view
          wx:for="{{calendarCells}}"
          wx:key="key"
          class="cal-cell {{item.inMonth ? 'in' : 'out'}} {{item.selected ? 'sel' : ''}} {{item.today ? 'today' : ''}}"
          data-date="{{item.date}}"
          bindtap="pickDay"
          hover-class="cal-cell-hover"
          aria-role="button"
          aria-label="{{item.date}}"
        >
          <view class="cal-day">{{item.day}}</view>
        </view>
      </view>
    </view>

    <view class="line-row title-row">
      <text class="line-label">标题</text>
      <input
        class="line-input"
        placeholder="日程标题，例如 项目评审"
        placeholder-class="line-placeholder"
        value="{{form.title}}"
        maxlength="-1"
        bindinput="onTitle"
        confirm-type="done"
      />
      <text class="line-counter">{{titleBytes}}/{{titleLimit}}</text>
    </view>

    <view class="line-row note-row">
      <text class="line-label">备注</text>
      <textarea
        class="line-textarea"
        placeholder="备注（可选）"
        placeholder-class="line-placeholder"
        value="{{form.note}}"
        maxlength="-1"
        bindinput="onNote"
      />
    </view>
    <view class="line-counter note-counter">{{noteBytes}}/{{noteLimit}}</view>

    <view wx:if="{{!loggedIn}}" class="inline-tip">
      未登录，保存后只存在本机，不会上传云端或同步设备
    </view>
    <view wx:elif="{{!connected}}" class="inline-tip">
      未连接设备蓝牙，保存后云端储存，连接设备时自动同步
    </view>

    <button class="btn primary block save-btn" bindtap="submit" loading="{{busy}}" disabled="{{busy || voicePhase !== ''}}">
      保存日程
    </button>
  </view>

  <view class="log-wrap">
    <view class="log-toggle" bindtap="toggleLog">
      {{logOpen ? '收起协议日志' : '查看蓝牙协议日志'}}
    </view>
    <scroll-view wx:if="{{logOpen}}" class="log" scroll-y>
      <view wx:for="{{logs}}" wx:key="id" class="log-line">{{item.line}}</view>
      <view wx:if="{{!logs.length}}" class="log-line">（连接设备后显示）</view>
    </scroll-view>
  </view>

  <!-- Pairing code: page-level so the hint stays in the placeholder and the
       retry error gets its own line instead of the input box. -->
  <view wx:if="{{pairingVisible}}" class="pairing-mask" catchtouchmove="noop">
    <view class="pairing-card">
      <view class="pairing-title">设备配对</view>
      <input
        class="input pairing-input"
        placeholder="请输入设备屏幕上的 12 位配对码"
        placeholder-class="pairing-placeholder"
        value="{{pairingValue}}"
        focus="{{pairingFocus}}"
        maxlength="24"
        confirm-type="done"
        bindinput="onPairingInput"
        bindconfirm="confirmPairing"
      />
      <view wx:if="{{pairingError}}" class="pairing-error">{{pairingError}}</view>
      <view wx:else class="pairing-hint">不区分大小写，例如 K7Q4M2X9B3TF</view>
      <view class="pairing-actions">
        <button class="btn pairing-btn" bindtap="cancelPairing">取消</button>
        <button class="btn primary pairing-btn" bindtap="confirmPairing">配对</button>
      </view>
    </view>
  </view>
</view>
