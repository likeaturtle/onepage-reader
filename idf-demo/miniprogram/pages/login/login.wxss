/* 登录 · 一张纸：字标、细线、一段说明、一个墨条 */

.login-page {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 160rpx) 56rpx calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #fbfaf6;
  display: flex;
  flex-direction: column;
}

.logo {
  display: block;
  width: 156rpx;
  height: 156rpx;
}

.title {
  margin-top: 24rpx;
  font-size: 70rpx;
  font-weight: 300;
  line-height: 1.15;
  letter-spacing: 0.02em;
  color: #17181a;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 22rpx;
  letter-spacing: 0.3em;
  color: #8b8578;
}

.login-body {
  margin-top: 72rpx;
}

.hair {
  height: 1rpx;
  background: #ddd7c9;
}

.panel-desc {
  margin-top: 28rpx;
  max-width: 570rpx;
  font-size: 28rpx;
  line-height: 2;
  color: #4e4b45;
}

.login-foot {
  margin-top: auto;
}

.btn.dev {
  margin-top: 20rpx;
  color: #6f6b61;
  border-color: #ddd7c9;
}

.login-error {
  margin-top: 24rpx;
  padding: 12rpx 0 12rpx 20rpx;
  border-left: 4rpx solid #9c3427;
  color: #9c3427;
  font-size: 24rpx;
  line-height: 1.7;
}

.note {
  margin-top: 24rpx;
  font-size: 22rpx;
  line-height: 1.8;
  color: #9a9487;
}

.foot {
  margin-top: 32rpx;
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 0.02em;
  color: #b0aa98;
  word-break: break-all;
}
