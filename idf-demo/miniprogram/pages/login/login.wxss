/* 登录 · 一张纸：品牌抬头、今天的日期、一个墨条和一个安静入口。
 * 登录是可选的，页面左上角保留一条返回本机模式的路。 */

.login-page {
  position: relative;
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 160rpx) 56rpx calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #fbfaf6;
  display: flex;
  flex-direction: column;
}

.back {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 24rpx);
  left: 40rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 16rpx 12rpx 8rpx;
}

.back-hover {
  opacity: 0.55;
}

.back-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: #6f6b61;
}

.back-label {
  font-size: 24rpx;
  letter-spacing: 0.08em;
  color: #9a9487;
}

.brand {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.logo {
  display: block;
  width: 96rpx;
  height: 96rpx;
  flex: none;
}

.brand-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1.1;
  letter-spacing: 0.02em;
  color: #17181a;
}

.subtitle {
  font-size: 22rpx;
  line-height: 1.3;
  letter-spacing: 0.3em;
  color: #8b8578;
}

/* The one sharp element: today's number, in the same voice as the 添加 tab. */
.today {
  margin-top: 96rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #17181a;
}

.today-kicker {
  display: block;
  font-size: 22rpx;
  line-height: 1.4;
  letter-spacing: 0.18em;
  color: #9a9487;
}

.today-row {
  display: flex;
  align-items: flex-end;
  gap: 24rpx;
  margin-top: 10rpx;
}

.today-day {
  font-size: 200rpx;
  font-weight: 200;
  line-height: 0.82;
  letter-spacing: -0.04em;
  color: #17181a;
  font-feature-settings: "tnum";
}

.today-side {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-bottom: 12rpx;
  font-size: 26rpx;
  line-height: 1.4;
  letter-spacing: 0.08em;
  color: #6f6b61;
}

/* The printed month is context, not a date picker: no tap handlers, no
 * selected state, and no neighbouring-month numbers. */
.month {
  margin-top: 56rpx;
}

.month-week {
  display: flex;
}

.month-wd {
  flex: 1 1 0;
  min-width: 0;
  padding-bottom: 8rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 0.04em;
  color: #b0aa98;
}

.month-cell {
  flex: 1 1 0;
  min-width: 0;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #9a9487;
  font-feature-settings: "tnum";
}

.month-day {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  box-sizing: border-box;
}

.month-day.on {
  border: 1rpx solid #17181a;
  color: #17181a;
}

.login-foot {
  margin-top: auto;
  padding-top: 64rpx;
}

.login-error {
  margin-bottom: 24rpx;
  padding: 12rpx 0 12rpx 20rpx;
  border-left: 4rpx solid #9c3427;
  color: #9c3427;
  font-size: 24rpx;
  line-height: 1.7;
}

.dev-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: #a39c8d;
}

.dev-entry-hover {
  opacity: 0.55;
}

/* On 16:9 phones the login CTA needs the height more than the decorative
 * month does; the month returns on the taller screens where the blank gap
 * actually exists. */
@media (max-height: 760px) {
  .month {
    display: none;
  }
}
