# OnePage C61 calendar — ESP-IDF defaults.
#
# Requires ESP-IDF >= 5.5 for ESP32-C61 support (the vendor firmware is built
# against 5.5.2; this project is verified with 6.1). Build with:
#   idf.py set-target esp32c61 && idf.py build

# --- Flash: 16 MB, DIO, 80 MHz (PY25Q128HA / W25Q128JW both rate >= 104 MHz) --
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- 2 MB PSRAM ---------------------------------------------------------------
# Quad mode at 40 MHz: the C61HR2 part inits unreliably at 80 MHz.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Skip the boot-time full-SPI-RAM test: it writes and verifies the whole part
# (~1.5 s on 8 MB @ 40 MHz) on every reset, and a deep-sleep wake is a reset.
# That test is the single largest part of the wake latency; re-enable it on a
# brand-new board when validating the PSRAM.
CONFIG_SPIRAM_MEMTEST=n

# --- Console ------------------------------------------------------------------
# The console must go to the ROM USB-Serial/JTAG device, never UART0: GPIO10 is
# the charger enable (BAT_CHG_EN) and GPIO11 is the USB detect input, and those
# are the C61's default UART0 TX/RX pins. USB-Serial/JTAG also matches how the
# board is wired (USB-C straight into the chip) and how esptool talks to it.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- Partition table ----------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Housekeeping -------------------------------------------------------------
# A full panel refresh busy-waits for up to a couple of seconds.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

# --- BLE (NimBLE peripheral only) ---------------------------------------------
# The phone web page uses Web Bluetooth; the device is a GATT server.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="Mochen CalCal"
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120

# --- Low power ----------------------------------------------------------------
# 32.768 kHz crystal is on the board (DEVNOTES section 2). BLE and the system
# RTC both use it, which is the low-current light-sleep configuration for C6/
# C61. The app calls esp_pm_configure() with light_sleep_enable=true.
CONFIG_RTC_CLK_SRC_EXT_CRYS=y
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_BT_LE_LP_CLK_SRC_DEFAULT=y
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=y
# Do NOT power down digital peripherals in light sleep: the SAR ADC (front keys,
# battery) and USB-Serial/JTAG console are not retention-supported on the C61.
CONFIG_PM_POWER_DOWN_PERIPHERAL_IN_LIGHT_SLEEP=n
CONFIG_ESP_MODEM_CLOCK_ENABLE_CHECKING=y
CONFIG_ESP_SLEEP_CACHE_SAFE_ASSERTION=y

# The UI task parses JSON/BLE events and renders; 3.5 KB is too tight.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
