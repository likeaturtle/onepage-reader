# Copy to .env and fill in. All values are read at startup.
PORT=8787
HOST=0.0.0.0
# Set to 1 only when nginx (or another local proxy) overwrites X-Real-IP.
TRUST_PROXY=0

# WeChat mini program credentials (mini program admin -> 开发 -> 开发设置).
# Never put WX_SECRET into the mini program source: it stays here.
WX_APPID=
WX_SECRET=

# HMAC key for login tokens. Generate one with: openssl rand -hex 32
SESSION_SECRET=dev-only-secret-change-me

# Allow the password-less { "dev": true } login. Useful in local development,
# must be 0 in production.
ALLOW_DEV_LOGIN=1

TOKEN_TTL_DAYS=7
DATA_DIR=./data
MAX_AVATAR_BYTES=524288
CORS_ORIGIN=*

# --- Data encryption (production requires both keys) -----------------------
# 32-byte keys, base64. Generate with: openssl rand -base64 32
# DATA_KEY encrypts nicknames and event titles/notes.
# INDEX_KEY keys the HMAC used to look users up by openid (openid is never
# stored in plaintext). Changing either key without a matching *_OLD_KEYS entry
# makes existing data unreadable.
# In development, leaving both empty derives keys from SESSION_SECRET; changing
# SESSION_SECRET then also makes existing data unreadable.
DATA_KEY=
DATA_KEY_ID=k1
# Optional, decrypt-only entries used while rotating: k0:<base64>,k1:<base64>
DATA_OLD_KEYS=

INDEX_KEY=
INDEX_KEY_ID=k1
# Fallback for legacy records created before openidEnc existed.
INDEX_OLD_KEYS=

# --- Encrypted backups -----------------------------------------------------
# Separate 32-byte base64 key for `npm run backup` / `npm run restore`.
# Keep it somewhere other than the backup target (password manager / KMS).
BACKUP_KEY=
