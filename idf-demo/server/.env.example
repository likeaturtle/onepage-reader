# Copy to .env and fill in. All values are read at startup.
PORT=8787
HOST=0.0.0.0

# WeChat mini program credentials (mini program admin -> 开发 -> 开发设置).
# Never put WX_SECRET into the mini program source: it stays here.
WX_APPID=
WX_SECRET=

# HMAC key for login tokens. Generate one with: openssl rand -hex 32
SESSION_SECRET=dev-only-secret-change-me

# Allow the password-less { "dev": true } login. Useful in local development,
# must be 0 in production. Keep it 1 locally until WX_APPID/WX_SECRET are set.
ALLOW_DEV_LOGIN=1

TOKEN_TTL_DAYS=7
DATA_DIR=./data
MAX_AVATAR_BYTES=524288
CORS_ORIGIN=*
