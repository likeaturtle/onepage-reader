# ============================================================
# 墨程CalCal 服务端 - 生产环境配置
# 文件位置：idf-demo/server/.env
# 注意：.env 已被 .gitignore 忽略，不要提交到仓库
# ============================================================

# ---------- 运行环境 ----------
# 必须是 production，服务端会拒绝默认 SESSION_SECRET
NODE_ENV=production

# 只监听本机，由 Nginx / Caddy 反向代理到 443
HOST=127.0.0.1
PORT=8787

# 只有在本机反向代理会覆盖 X-Real-IP 时才设为 1
# 用于登录限流拿真实客户端 IP；Node 直接暴露公网时必须设 0
TRUST_PROXY=1

# ---------- 微信小程序 ----------
# 微信公众平台 -> 开发 -> 开发设置
WX_APPID=你的微信小程序 AppID
WX_SECRET=你的微信小程序 Secret

# ---------- DeepSeek 语音日程 ----------
# 语音识别 + 文本解析。Key 只放服务端，绝不能写进小程序。
# 不填时语音卡片提示未配置，其他功能正常。
DEEPSEEK_API_KEY=你的 DeepSeek API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选 deepseek-flash / deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=30000
# “明天/下周三”按这个时区换算
SCHEDULE_TIMEZONE=Asia/Shanghai

# 公网生产必须关闭开发模式登录
ALLOW_DEV_LOGIN=0

# ---------- 登录 token ----------
# 保留你原来的 64 位 hex，不要换成新值，否则所有已登录 token 立即失效
# 如果确实要轮换，直接替换即可，用户重新登录一次，密钥生成使用：
#   openssl rand -hex 32
SESSION_SECRET=你的 64 字节 Hex 生成密钥

# 登录有效期，单位：天
TOKEN_TTL_DAYS=7

# ---------- 数据存储 ----------
# 必须是持久化目录，且运行用户有写权限
# 里面会生成 users.json、events.json、avatars/
# 注意：如果 systemd 单元里有 ProtectHome=true，/home 下会不可写，见文末说明
DATA_DIR=你的数据目录地址

# 头像大小上限，默认 512 KiB
MAX_AVATAR_BYTES=524288

# ---------- CORS ----------
# 小程序请求不受 CORS 限制；这里主要是给网页版使用
# 没有网页版可以保持 *；有网页版就填那一个来源
CORS_ORIGIN=*

# ---------- 数据加密（新增，生产必填） ----------
# 32 字节 base64，生成命令：
#   openssl rand -base64 32

# DATA_KEY 加密 profile / event payload / openid 副本
DATA_KEY=你的 32 字节 Base64 生成密钥
DATA_KEY_ID=k1
# 轮换时才填，格式 k0:<base64>,k1:<base64>；新部署留空
DATA_OLD_KEYS=

# INDEX_KEY 用于 openid 的 HMAC 索引
INDEX_KEY=你的 32 字节 Base64 生成密钥
INDEX_KEY_ID=k1
# 新数据启动时会用 openidEnc 自动重算索引；这里一般留空
INDEX_OLD_KEYS=

# ---------- 加密备份（新增） ----------
# 与 DATA_KEY / INDEX_KEY 分开保管
# 备份文件本身用这把 key 加密；丢失后备份无法恢复
BACKUP_KEY=你的 32 字节 Base64 生成密钥